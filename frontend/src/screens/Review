import React, { useEffect, useState } from 'react';
import {
  View,
  Text,
  FlatList,
  StyleSheet,
  TouchableOpacity,
} from 'react-native';

import {
  getSentences,
  deleteSentence,
} from '../../api/reviewApi';

interface Sentence {
  id: number;
  content: string;
  pageNumber: number;
}

const SentenceScreen = ({ route }: any) => {
  const { readingRecordId } = route.params;

  const [sentences, setSentences] = useState<Sentence[]>([]);

  const loadSentences = async () => {
    try {
      const data = await getSentences(readingRecordId);
      setSentences(data);
    } catch (error) {
      console.error(error);
    }
  };

  const handleDelete = async (sentenceId: number) => {
    try {
      await deleteSentence(sentenceId);
      loadSentences();
    } catch (error) {
      console.error(error);
    }
  };

  useEffect(() => {
    loadSentences();
  }, []);

  return (
    <View style={styles.container}>

      <Text style={styles.title}>
        문장 모음
      </Text>

      <FlatList
        data={sentences}
        keyExtractor={(item) => item.id.toString()}
        renderItem={({ item }) => (

          <View style={styles.card}>

            <Text style={styles.sentence}>
              {item.content}
            </Text>

            <Text style={styles.page}>
              {item.pageNumber} 페이지
            </Text>

            <TouchableOpacity
              onPress={() => handleDelete(item.id)}
            >
              <Text>삭제</Text>
            </TouchableOpacity>

          </View>

        )}
      />

    </View>
  );
};

export default SentenceScreen;

const styles = StyleSheet.create({

  container: {
    flex: 1,
    padding: 20,
  },

  title: {
    fontSize: 24,
    fontWeight: 'bold',
    marginBottom: 20,
  },

  card: {
    padding: 15,
    marginBottom: 10,
    borderWidth: 1,
    borderRadius: 10,
  },

  sentence: {
    fontSize: 16,
  },

  page: {
    marginTop: 5,
  },

});
