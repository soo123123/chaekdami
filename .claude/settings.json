{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          { "type": "command", "command": "python3 -B \"${CLAUDE_PROJECT_DIR}/.claude/hooks/session-news.py\"", "timeout": 20 }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "python3 -B \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-git.py\"" }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          { "type": "command", "command": "python3 -B \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-files.py\"" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "python3 -B \"${CLAUDE_PROJECT_DIR}/.claude/hooks/check-after-edit.py\"" }
        ]
      }
    ]
  }
}
